# Anthropic API key (required). Create one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Claude model used for classification and drafting
CLAUDE_MODEL=claude-sonnet-4-5-20250929

# Gmail search query that selects which messages to triage.
# Default is unread messages in the inbox.
GMAIL_QUERY=is:unread in:inbox

# How many messages to actually process per run (the delegation ceiling).
MAX_MESSAGES=10

# Hard spend ceiling per run, in USD. The agent stops before starting a new
# message once estimated model spend reaches this, no matter how full the
# inbox is. Cost is estimated from the token usage the API reports.
MAX_RUN_USD=0.50
PRICE_IN_PER_MTOK=3.0
PRICE_OUT_PER_MTOK=15.0

# A ROUTINE verdict below this confidence is downgraded to human review
# instead of being auto-drafted. Raise it to be more cautious.
MIN_ROUTINE_CONFIDENCE=0.75

# SQLite file holding durable processed-message state. This is what stops a
# re-run (or an overlapping run) from drafting a reply twice for one message.
STATE_DB=triage_state.db

# Brand voice used when drafting routine replies. Describe tone, formality,
# and anything to always or never do. This is the one knob to re-skin the
# agent for a different client.
BRAND_VOICE=Friendly, concise, and professional. Warm but efficient. Use plain language, short paragraphs, and a genuinely helpful tone.

# Name used in the sign-off of drafted replies
SENDER_NAME=The Support Team

# Where the human-review queue is appended (JSONL)
REVIEW_QUEUE_FILE=review_queue.jsonl

# Where every action is appended (JSONL)
LOG_FILE=triage_log.jsonl

# OAuth client secrets downloaded from the Google Cloud Console
GOOGLE_CLIENT_SECRETS=credentials.json

# Where the OAuth token is cached after the first browser login
GOOGLE_TOKEN_FILE=token.json
