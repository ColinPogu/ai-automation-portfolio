# Copy this file to .env and fill in real values.
# In n8n these are read inside node expressions as {{ $env.NAME }}.
# When self-hosting with Docker, pass them with --env-file .env or an env block.
# n8n only exposes variables to expressions when N8N_BLOCK_ENV_ACCESS_IN_NODE is false (default false).

# Anthropic API key. Create one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-replace-me

# Optional. Model used for the personalized first line.
# Leave blank to use the workflow default (claude-3-5-haiku-20241022).
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Public URL that returns the leads as CSV text.
# Examples: a raw GitHub file, an S3 object, a published Google Sheet CSV export,
# or any endpoint that returns text/csv. See README for the Google Sheets CSV trick.
LEADS_CSV_URL=https://example.com/path/to/sample_leads.csv

# Google Sheet ID used for the "Drafts" log (the long id in the sheet URL).
# This single sheet is both the output log and the dedupe source.
DRAFTS_SHEET_ID=replace-with-google-sheet-id
