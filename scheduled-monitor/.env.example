# Copy this file to .env and fill in your values. The .env file is read at
# startup and should never be committed. Real environment variables take
# priority over anything in .env.

# Slack incoming webhook that receives the alerts.
# Create one at https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXXXXXXXX/YYYYYYYYY/ZZZZZZZZZZZZ

# Optional overrides (defaults shown).
# CONFIG_PATH=config.yaml
# DATABASE_PATH=monitor.db
# LOG_LEVEL=INFO
# DRY_RUN=false
